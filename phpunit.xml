<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <groups>
        <exclude>
            <group>concurrency</group>
        </exclude>
    </groups>
    <php>
        <!-- force="true": Compose's env_file sets real env vars (APP_ENV=local, DB_DATABASE=app) that would
             otherwise win over these, and RefreshDatabase would wipe the real database. Laravel reads $_SERVER
             before $_ENV, so every forced value is set in both (<env> and <server>). -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="postgres" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="app_test" force="true"/>
        <env name="DB_USERNAME" value="app" force="true"/>
        <env name="DB_PASSWORD" value="secret" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="POOL_WINDOW_SCALE" value="1" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_HOST" value="postgres" force="true"/>
        <server name="DB_PORT" value="5432" force="true"/>
        <server name="DB_DATABASE" value="app_test" force="true"/>
        <server name="DB_USERNAME" value="app" force="true"/>
        <server name="DB_PASSWORD" value="secret" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="POOL_WINDOW_SCALE" value="1" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
